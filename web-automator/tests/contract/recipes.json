    {"name": "output_dir on a screenshot", "reason": "output_dir is gone", "recipe": {"url": "https://example.com", "steps": [{"action": "screenshot", "output_dir": "/etc"}]}},
    {"name": "a field of another action", "reason": "only the action's own fields", "recipe": {"url": "https://example.com", "steps": [{"action": "click", "selector": "a", "value": "x"}]}},
