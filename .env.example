# === Required ===
# Two database roles. The owner owns the schema and runs migrations, in the
# one-shot migrate service only. The application role is what AlexClaw
# connects as: it cannot rewrite the audit log, and AlexClaw refuses to start
# as the owner. Use two different passwords.
DATABASE_OWNER_USERNAME=alexclaw
DATABASE_OWNER_PASSWORD=changeme_owner
DATABASE_USERNAME=alexclaw_app
DATABASE_PASSWORD=changeme_app
# At least 64 bytes: openssl rand -base64 48. The application refuses to start
# with this placeholder. It is also the key stored secrets are encrypted with:
# keep it with your backups, and change it only by rotation
# (docs/deployment/rotate-secret-key-base.md).
SECRET_KEY_BASE=CHANGE_ME
ADMIN_PASSWORD=changeme

# Erlang distribution cookie. Anyone who knows it and can reach the node's
# distribution port can run code as the application, so it is generated, never
# chosen. There is no default: the container refuses to start without one.
#   openssl rand -base64 32
CLUSTER_COOKIE=

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# === LLM Providers (at least one required) ===
# Free tier: https://ai.google.dev/
GEMINI_API_KEY=
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# === Local Models (optional) ===
# OLLAMA_ENABLED=true
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2

# LMSTUDIO_ENABLED=true
# LMSTUDIO_HOST=http://host.docker.internal:1234
# LMSTUDIO_MODEL=qwen2.5-14b-instruct

# === Discord (optional — alternative/additional gateway) ===
# Create a bot at https://discord.com/developers/applications
# Enable MESSAGE CONTENT intent in Bot settings
#
# Discord is NOT configured by environment. Set discord.enabled,
# discord.bot_token and discord.channel_id in Admin > Config, then restart the
# container. The channel is auto-detected on the first message if left blank.

# === Google OAuth (optional — for Calendar, Keep skills) ===
# See INSTALLATION.md > Google Calendar Setup
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# === Web automator (optional, experimental) ===
# A Playwright sidecar, not built or started unless its profile is active.
# COMPOSE_PROFILES=web-automation
# WEB_AUTOMATOR_ENABLED=true
# Shared by AlexClaw and the sidecar; the sidecar refuses every request without
# it. Generate with: openssl rand -hex 32
# WEB_AUTOMATOR_TOKEN=

# === Advanced ===
# ADMIN_PORT=5001

# The admin UI is published on 127.0.0.1 only. Session cookies and MCP bearer
# tokens travel in clear over HTTP, so reaching it from another machine wants a
# reverse proxy terminating TLS — see INSTALLATION.md. Set it to 0.0.0.0 for
# every interface, or to one machine's IP to publish on that interface only.
# ADMIN_BIND=0.0.0.0
# ADMIN_BIND=192.168.1.10

# Origins the LiveView socket will accept. Unset, it accepts both loopback
# spellings on ADMIN_PORT (5001 by default), plus https://$PHX_HOST when set.
#
# Behind a reverse proxy, set this to the public origin — the browser sends the
# address it was given, not the one the container sees. Get it wrong and the
# page renders while every button does nothing: the socket is rejected and the
# only trace is "Could not check origin" in the log.
# PHX_HOST=alexclaw.example.com
# CHECK_ORIGIN=https://alexclaw.example.com
