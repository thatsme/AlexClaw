    {"name": "select without value", "reason": "value is required", "recipe": {"url": "https://example.com", "steps": [{"action": "select", "selector": "select"}]}},
    {"name": "check without checked", "reason": "checked is required", "recipe": {"url": "https://example.com", "steps": [{"action": "check", "selector": "#agree"}]}},
    {"name": "check with a string", "reason": "checked is a boolean", "recipe": {"url": "https://example.com", "steps": [{"action": "check", "selector": "#agree", "checked": "yes"}]}},
    {"name": "check with the old value field", "reason": "value is not a check field", "recipe": {"url": "https://example.com", "steps": [{"action": "check", "selector": "#agree", "value": "on"}]}},
    {"name": "navigate without url", "reason": "url is required", "recipe": {"url": "https://example.com", "steps": [{"action": "navigate"}]}},
    {"name": "navigate to a file", "reason": "only http(s)", "recipe": {"url": "https://example.com", "steps": [{"action": "navigate", "url": "file:///etc/passwd"}]}},
    {"name": "wait zero", "reason": "seconds > 0", "recipe": {"url": "https://example.com", "steps": [{"action": "wait", "seconds": 0}]}},
    {"name": "wait too long", "reason": "seconds <= 60", "recipe": {"url": "https://example.com", "steps": [{"action": "wait", "seconds": 61}]}},
    {"name": "wait as a string", "reason": "seconds is a number", "recipe": {"url": "https://example.com", "steps": [{"action": "wait", "seconds": "8"}]}},
    {"name": "wait with the old value field", "reason": "value is not a wait field", "recipe": {"url": "https://example.com", "steps": [{"action": "wait", "value": "8"}]}},
    {"name": "keyboard without key", "reason": "key is required", "recipe": {"url": "https://example.com", "steps": [{"action": "keyboard"}]}},
    {"name": "download without selector", "reason": "selector is required", "recipe": {"url": "https://example.com", "steps": [{"action": "download"}]}},
    {"name": "extract_grid without selector", "reason": "selector is required", "recipe": {"url": "https://example.com", "steps": [{"action": "extract_grid"}]}},
    {"name": "screenshot name with a path", "reason": "name is [a-z0-9_-]{1,40}", "recipe": {"url": "https://example.com", "steps": [{"action": "screenshot", "name": "../../etc/x"}]}},
    {"name": "screenshot name too long", "reason": "name is [a-z0-9_-]{1,40}", "recipe": {"url": "https://example.com", "steps": [{"action": "screenshot", "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}},
