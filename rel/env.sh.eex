#!/bin/sh
# Sourced by bin/alex_claw before every command — start, eval, rpc, remote,
# daemon — rather than only by the one the entrypoint runs.
#
# That is the whole point of it being here. These three exports used to live in
# entrypoint.sh, which meant they applied to the process it started and to
# nothing else: `docker exec <container> bin/alex_claw rpc ...` came up with an
# unset RELEASE_NODE, guessed the defaults, and failed with :noconnection. An
# operator could not open a remote shell on a running node without knowing to
# re-export all three by hand.
#
# Written as plain sh on purpose. This file is an EEx template evaluated when
# the release is built, so anything in <%%= %> would be frozen at build time;
# what is wanted is the value the container has when the command runs.
#
# `if` rather than `[ -n "$X" ] && export ...`, because bin/alex_claw runs with
# set -e and a trailing test that is false would abort the command.

if [ -n "$NODE_NAME" ]; then
  export RELEASE_NODE="$NODE_NAME"
fi

if [ -n "$CLUSTER_COOKIE" ]; then
  export RELEASE_COOKIE="$CLUSTER_COOKIE"
fi

# A name with a dot in it is a long name, which needs -name rather than -sname.
case "$NODE_NAME" in
  *.*) export RELEASE_DISTRIBUTION=name ;;
esac
