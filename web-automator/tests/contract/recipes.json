{
  "_about": "The recipe contract, v1 (reports/WEB_AUTOMATOR_TARGET.md §2). Both test suites iterate this file: the sidecar's pydantic model (app.recipe.Recipe) and AlexClaw's AlexClaw.WebAutomation.Recipe.validate/1 must accept every 'valid' recipe and refuse every 'invalid' one. A recipe one side accepts and the other refuses is a red build on the side that disagrees. Rules: a recipe is exactly {url, steps}; url is http(s); every step has an action from actions.json and only that action's fields plus optional timeout_ms (1..120000); unknown keys anywhere are refused.",
  "valid": [
    {"name": "no steps", "recipe": {"url": "https://example.com", "steps": []}},
    {"name": "http url", "recipe": {"url": "http://example.com/login", "steps": []}},
    {"name": "navigate", "recipe": {"url": "https://example.com", "steps": [{"action": "navigate", "url": "https://example.com/reports"}]}},
    {"name": "click", "recipe": {"url": "https://example.com", "steps": [{"action": "click", "selector": "button[type=submit]"}]}},
    {"name": "click with timeout", "recipe": {"url": "https://example.com", "steps": [{"action": "click", "selector": "#go", "timeout_ms": 30000}]}},
    {"name": "fill", "recipe": {"url": "https://example.com", "steps": [{"action": "fill", "selector": "#user", "value": "alex"}]}},
    {"name": "fill empty value", "recipe": {"url": "https://example.com", "steps": [{"action": "fill", "selector": "#search", "value": ""}]}},
    {"name": "fill a date field", "recipe": {"url": "https://example.com", "steps": [{"action": "fill", "selector": "#from", "value": "2026-09-01", "input_type": "date"}]}},
    {"name": "select", "recipe": {"url": "https://example.com", "steps": [{"action": "select", "selector": "select[name=account]", "value": "main"}]}},
    {"name": "check", "recipe": {"url": "https://example.com", "steps": [{"action": "check", "selector": "#agree", "checked": true}]}},
    {"name": "uncheck", "recipe": {"url": "https://example.com", "steps": [{"action": "check", "selector": "#newsletter", "checked": false}]}},
    {"name": "wait", "recipe": {"url": "https://example.com", "steps": [{"action": "wait", "seconds": 2}]}},
    {"name": "wait a fraction", "recipe": {"url": "https://example.com", "steps": [{"action": "wait", "seconds": 0.5}]}},
    {"name": "wait the maximum", "recipe": {"url": "https://example.com", "steps": [{"action": "wait", "seconds": 60}]}},
    {"name": "keyboard", "recipe": {"url": "https://example.com", "steps": [{"action": "keyboard", "key": "Enter"}]}},
    {"name": "download", "recipe": {"url": "https://example.com", "steps": [{"action": "download", "selector": "a.export", "timeout_ms": 120000}]}},
    {"name": "scrape all tables", "recipe": {"url": "https://example.com", "steps": [{"action": "scrape"}]}},
    {"name": "scrape one table", "recipe": {"url": "https://example.com", "steps": [{"action": "scrape", "selector": "table#results"}]}},
    {"name": "scrape the page text", "recipe": {"url": "https://example.com", "steps": [{"action": "scrape_text"}]}},
    {"name": "scrape a region's text", "recipe": {"url": "https://example.com", "steps": [{"action": "scrape_text", "selector": "main"}]}},
    {"name": "extract a grid", "recipe": {"url": "https://example.com", "steps": [{"action": "extract_grid", "selector": "#jqxgrid"}]}},
    {"name": "screenshot", "recipe": {"url": "https://example.com", "steps": [{"action": "screenshot"}]}},
    {"name": "named full-page screenshot", "recipe": {"url": "https://example.com", "steps": [{"action": "screenshot", "name": "after-login_1", "full_page": true}]}},
    {"name": "a login flow", "recipe": {"url": "https://portal.example.com/login", "steps": [
      {"action": "fill", "selector": "#user", "value": "alex"},
      {"action": "fill", "selector": "#password", "value": "not-a-real-password"},
      {"action": "click", "selector": "button[type=submit]"},
      {"action": "wait", "seconds": 1},
      {"action": "navigate", "url": "https://portal.example.com/invoices"},
      {"action": "download", "selector": "a.latest"}
    ]}}
