<div class="space-y-8">
  <AlexClawWeb.CoreComponents.elevation_bar elevation={@elevation} />

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-white">Secrets</h1>
      <p class="text-xs text-gray-500 mt-1">
        Values are kept in OpenBao. This page shows what each secret is and where it may be used — never a value.
      </p>
    </div>
    <button phx-click="toggle_form" class="px-4 py-2 bg-claw-700 hover:bg-claw-600 text-white text-sm rounded transition">
      {if @show_form, do: "Cancel", else: "Define Secret"}
    </button>
  </div>

  <div :if={@show_form} class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h3 class="text-md font-semibold text-white mb-3">New Secret</h3>
    <form phx-submit="save_secret" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs text-gray-400 mb-1">Name</label>
        <input type="text" name="secret[name]" required placeholder="erp_db_password"
          class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-sm text-white font-mono" />
        <p class="text-xs text-gray-500 mt-1">Lower-case letters, digits and underscores. It cannot be changed later.</p>
      </div>
      <div>
        <label class="block text-xs text-gray-400 mb-1">Kind</label>
        <select name="secret[kind]" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-sm text-white">
          <option :for={k <- @kinds} value={k}>{k}</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs text-gray-400 mb-1">Binding</label>
        <input type="text" name="secret[binding]" required placeholder="host:api.github.com, connection:erp"
          class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-sm text-white font-mono" />
        <p class="text-xs text-gray-500 mt-1">
          Where the secret may be used, matched exactly: host:&lt;hostname&gt;, connection:&lt;name&gt;, or origin:&lt;scheme://host[:port]&gt;.
        </p>
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs text-gray-400 mb-1">Description</label>
        <input type="text" name="secret[description]"
          class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-sm text-white" />
      </div>
      <div class="md:col-span-2">
        <button type="submit" class="px-4 py-2 bg-claw-700 hover:bg-claw-600 text-white text-sm rounded transition">Define</button>
      </div>
    </form>
  </div>

  <div class="bg-gray-900 rounded-lg border border-gray-800 overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-800">
        <tr>
          <th class="px-4 py-3 text-left text-xs text-gray-400 uppercase">Secret</th>
          <th class="px-4 py-3 text-left text-xs text-gray-400 uppercase">Kind</th>
          <th class="px-4 py-3 text-left text-xs text-gray-400 uppercase">Binding</th>
          <th class="px-4 py-3 text-left text-xs text-gray-400 uppercase">Value</th>
          <th class="px-4 py-3 text-right text-xs text-gray-400 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr :if={@secrets == []} class="border-t border-gray-800">
          <td colspan="5" class="px-4 py-8 text-center text-gray-500">No secrets defined.</td>
        </tr>
        <tr :for={s <- @secrets} class="border-t border-gray-800 align-top">
          <td class="px-4 py-3">
            <div class="text-sm font-semibold text-white font-mono">{s.name}</div>
            <div :if={s.description} class="text-xs text-gray-500">{s.description}</div>
          </td>
          <td class="px-4 py-3">
            <span class="text-xs px-2 py-0.5 rounded bg-gray-800 text-gray-400 font-mono">{s.kind}</span>
          </td>
          <td class="px-4 py-3 text-xs text-gray-300 font-mono">
            <div :for={b <- s.binding}>{b}</div>
          </td>
          <td class="px-4 py-3 text-xs">
            <span :if={s.rotated_at} class="text-green-300">set {Calendar.strftime(s.rotated_at, "%Y-%m-%d %H:%M UTC")}</span>
            <span :if={!s.rotated_at} class="text-amber-300">no value</span>
            <form :if={@value_for == s.name} phx-submit="set_value" class="mt-2 flex gap-2">
              <input type="hidden" name="name" value={s.name} />
              <input type="password" name="value" value="" autocomplete="new-password" required
                class="bg-gray-800 border border-gray-700 rounded px-2 py-1 text-sm text-white" />
              <button type="submit" class="px-2 py-1 bg-claw-700 hover:bg-claw-600 text-white text-xs rounded">Set</button>
              <button type="button" phx-click="cancel_value" class="px-2 py-1 bg-gray-700 text-white text-xs rounded">Cancel</button>
            </form>
          </td>
          <td class="px-4 py-3 text-right space-x-2">
            <button phx-click="edit_value" phx-value-name={s.name}
              class="text-xs text-claw-500 hover:text-claw-400">{if s.rotated_at, do: "Rotate", else: "Set value"}</button>
            <button phx-click="delete_secret" phx-value-name={s.name}
              data-confirm="Delete this secret and its value in OpenBao?"
              class="text-xs text-red-500 hover:text-red-400">Delete</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
